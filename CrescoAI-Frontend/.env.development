VITE_CAREER_AGENT_CLIENT_MODE=upstream
# Root-relative on purpose: the Vite dev server proxies /api to 127.0.0.1:4000.
# Do not use "." here — a page-relative base is resolved against the current
# route, so /threads/<id> would send requests to /threads/api/... and 404.
VITE_CAREER_AGENT_API_BASE_URL=/
VITE_CAREER_AGENT_USER_ID=1
VITE_CAREER_AGENT_WITH_CREDENTIALS=false
VITE_CAREER_AGENT_ARTIFACT_TRANSPORT=polling
